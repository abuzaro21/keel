  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "typecheck": "node scripts/typecheck.mjs",
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "build": "vite build",
    "dev:ui": "vite",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
