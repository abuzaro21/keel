{
  "name": "keel",
  "version": "0.1.0",
  "private": true,
  "description": "KEEL — The Adaptive Agent. Runs a multi-step plan, notices when an observation breaks one of its own assumptions, repairs only the broken part, keeps finished work, and holds still when the world is too unstable to trust.",
